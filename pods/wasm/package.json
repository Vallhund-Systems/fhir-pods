{
  "name": "fhir-pods-wasm",
  "version": "0.8.6",
  "description": "Embeddable FHIR verifier — the fhir-pods Rust core as a ~385 KB WebAssembly module with a zero-dependency JS wrapper. Browser, edge, Node.",
  "license": "MIT",
  "author": "Justin Grosvenor",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./fhir_pods.wasm": "./dist/fhir_pods.wasm"
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "../../scripts/build-wasm.sh",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": ["fhir", "wasm", "validator", "healthcare"],
  "sideEffects": false
}
