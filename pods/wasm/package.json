{
  "name": "fhir-pods-wasm",
  "version": "0.22.0",
  "description": "Embeddable compliance runtime for health applications. FHIR lift/lower, validation, de-identification, documents, audit, and HL7 v2 through WebAssembly.",
  "license": "MIT",
  "author": "Justin Grosvenor",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./fhir_pods.wasm": "./dist/fhir_pods.wasm"
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "../../scripts/build-wasm.sh",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": ["fhir", "wasm", "compliance", "healthcare", "hl7", "validator"],
  "sideEffects": false
}
